# Required for the dashboard + all DB-backed features. Without these three the
# public profile still renders against seed/fixture data.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex, for AES-256-GCM token encryption. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional — Spotify connect button hides entirely when absent.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=        # e.g. http://127.0.0.1:3000/api/auth/spotify/callback

# Optional — film poster/year search. Manual entry still works without it.
TMDB_API_KEY=

# Shared secret protecting /api/cron/sync. Generate like ENCRYPTION_KEY.
CRON_SECRET=

# Rotated daily (a cron/redeploy step). Salts the asker IP hash so stored
# hashes can rate-limit but never identify a person.
ASK_DAILY_SALT=
